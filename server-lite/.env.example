# Port HTTP (défaut 3101 pour ne pas heurter le server complet sur 3001)
PORT=3101

# DB
DATABASE_URL=

# Mode mono-utilisateur : une clé API suffit (comme OPENBOT_SINGLE_USER)
LITE_API_KEY=dev-change-me

# Agents AG-UI sur localhost en dev
ALLOW_PRIVATE_HOSTS=true

# Politique par défaut : tout autoriser en enforce (comme le server complet)
# ACTION_POLICY_MODE=enforce

# Better auth 
BETTER_AUTH_SECRET=une-cle-secrete-tres-longue-et-aleatoire
BETTER_AUTH_URL=http://localhost:3101

# Google 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=